rules_version = '2';

// Sicherheitsregeln für Vorratsheld – in der Firebase-Konsole unter Firestore > Regeln einfügen
service cloud.firestore {
  match /databases/{database}/documents {

    // Produkte: jeder sieht und ändert nur seine eigenen
    match /products/{productId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Einkaufsliste: gleiche Regeln wie bei den Produkten
    match /shoppingItems/{itemId} {
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }

    // Profil: Dokument-ID = uid
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Hilfe-Anfragen: nur anlegen, lesen nur du in der Konsole
    match /supportRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
