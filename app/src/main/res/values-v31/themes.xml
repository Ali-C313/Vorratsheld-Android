<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Ab Android 12: System-Splash in Grün mit App-Icon, danach übernimmt der animierte Ladescreen -->
    <style name="Theme.Vorratsheld" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
    </style>
</resources>
